            "text_mh1s": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>We started with a simple question: what if hot sauce was built on extra virgin olive oil instead of vinegar?</p>",
                "underline_offset": -20,
                "type_preset": "paragraph"
              },
              "blocks": {}
            },
            "text_mh1t": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>The answer changed everything. By using first-press EVOO as our base, we created something that works as a marinade, cooking sauce, and finishing oil — not just a condiment.</p>",
                "underline_offset": -20,
                "type_preset": "paragraph"
              },
              "blocks": {}
            },
            "text_mh1u": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>Add in organic habanero peppers grown on our Virginia farm, and you get depth, versatility, and clean ingredients in every bottle.</p>",
                "underline_offset": -20,
                "type_preset": "paragraph"
              },
              "blocks": {}
            },
            "button_mh1v": {
              "type": "button",
              "name": "t:names.button",
